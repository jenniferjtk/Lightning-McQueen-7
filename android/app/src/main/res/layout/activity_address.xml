<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/shipping_address" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/shipping_address_subtitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/street"
                android:text="@string/street_address"
                android:textColor="@color/slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/street"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="postalAddress"
                android:imeOptions="actionNext"
                android:importantForAutofill="yes"
                android:inputType="textPostalAddress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/city"
                android:text="@string/city"
                android:textColor="@color/slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/city"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="addressLocality"
                android:imeOptions="actionNext"
                android:importantForAutofill="yes"
                android:inputType="textCapWords" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/state"
                android:text="@string/state_region"
                android:textColor="@color/slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/state"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="addressRegion"
                android:imeOptions="actionNext"
                android:importantForAutofill="yes"
                android:inputType="textCapWords" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/zip"
                android:text="@string/zip_code"
                android:textColor="@color/slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/zip"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="postalCode"
                android:imeOptions="actionNext"
                android:importantForAutofill="yes"
                android:inputType="textPostalAddress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/country"
                android:text="@string/country"
                android:textColor="@color/slate"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/country"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="addressCountry"
                android:imeOptions="actionDone"
                android:importantForAutofill="yes"
                android:inputType="textCapWords" />

            <TextView
                android:id="@+id/notice"
                style="@style/Text.Notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                style="@style/Text.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="assertive"
                android:visibility="gone" />

            <Button
                android:id="@+id/save"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:text="@string/save_address" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
