<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LightningMcQueen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/asphalt</item>
        <item name="colorPrimaryDark">@color/asphalt</item>
        <item name="colorAccent">@color/amber</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/asphalt</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/slate</item>
    </style>

    <!-- Buttons are sized for phones, not scaled-down desktop buttons. -->
    <style name="Button.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/card</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Button.Secondary" parent="Button.Primary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/asphalt</item>
    </style>

    <style name="Button.OnDark" parent="Button.Primary">
        <item name="android:background">@drawable/button_on_dark</item>
        <item name="android:textColor">#D8D3C6</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>

    <!-- Base for the Text.* styles below. -->
    <style name="Text" />

    <style name="Text.Eyebrow">
        <item name="android:textColor">@color/amber</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Text.Title">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Section">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/slate</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="Text.Error">
        <item name="android:background">@color/error_background</item>
        <item name="android:textColor">@color/negative</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Input">
        <item name="android:background">@drawable/input</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
